rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /meetings/{document=**} {
      allow read: if (request.auth != null) && (request.auth.token.role >= 25); // 25 = Role.OtherDepartment, the lowest provisioned role
      // Creating, editing and deleting meetings, proposals and votables is management work for the
      // Secretary and above: the ManageMeetings/ManageProposals/ManageVotables pages and meeting hosting.
      allow write: if hasRole(100);
    }

    // A ClassRep may only make the narrow, own-class updates the attendee pages make.
    match /meetings/{meetingId} {
      allow update: if isAttendee() && (punchesInOwnClass() || schedulesOwnAbsence());
    }

    match /meetings/{meetingId}/proposals/{proposalId} {
      allow update: if isAttendee() && togglesOwnSpeakRequest();
    }

    match /meetings/{meetingId}/proposals/{proposalId}/votables/{votableId} {
      allow update: if isAttendee() && castsOwnVote(meetingId, proposalId, votableId);
    }

    // User proposals are stored separately from the proposals on a meeting's agenda.
    match /proposal/{type}/{userId}/{proposalId} {
      // Shared co-sign links read one proposal; only its owner and management may list proposals.
      allow get: if isProposalType(type) && hasRole(25);
      allow list: if isProposalType(type) && (ownsProposal(userId) || hasRole(100));
      allow create: if isProposalType(type) && ownsProposal(userId);
      allow update: if isProposalType(type)
        && (ownsProposal(userId) || hasRole(100) || (isAttendee() && addsOwnCosignature()));
      allow delete: if isProposalType(type) && (ownsProposal(userId) || hasRole(100));
    }

    function isProposalType(type) {
      return type in ['law', 'general', 'presentation'];
    }

    function ownsProposal(userId) {
      return hasRole(25) && request.auth.uid == userId;
    }

    // A co-signer may append their own class without editing the proposal or earlier signatures.
    function addsOwnCosignature() {
      let before = resource.data.get('cosigners', []);
      let after = request.resource.data.get('cosigners', []);
      return onlyChanges(['cosigners'])
        && before is list && after is list
        && after.size() == before.size() + 1
        && after == before.concat([after[before.size()]])
        && isOwnCosigner(after[before.size()]);
    }

    function isOwnCosigner(cosigner) {
      return cosigner is map
        && cosigner.keys().hasAll(['classNum', 'jobTitle', 'name'])
        && cosigner.keys().hasOnly(['classNum', 'jobTitle', 'name'])
        && cosigner.classNum == ownClazz()
        && cosigner.jobTitle is string
        && cosigner.name is string && cosigner.name.size() > 0;
    }

    function hasRole(minRole) {
      return (request.auth != null) && ('token' in request.auth) && (request.auth.token.role >= minRole);
    }

    function ownClazz() {
      return request.auth.token.clazz;
    }

    function isAttendee() {
      return hasRole(50) && ownClazz() is string && ownClazz().size() > 0;
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function unchanged() {
      return request.resource.data.diff(resource.data).affectedKeys().size() == 0;
    }

    // PunchInPage: `participants: arrayUnion(clazz)`. Only the caller's own class may be appended, and
    // only while the meeting is in progress (`active`, set by the host's 開會 and cleared by 散會), so a
    // past or future meeting's attendance cannot be rewritten. No class can be removed. Repeating a
    // punch-in that is already recorded changes nothing and stays allowed. The punch-in passcode is not
    // part of the write, so it cannot be checked here.
    function punchesInOwnClass() {
      let before = resource.data.get('participants', []);
      let after = request.resource.data.get('participants', []);
      return onlyChanges(['participants'])
        && (after == before
          || (resource.data.get('active', false) == true
            && !(ownClazz() in before)
            && after == before.concat([ownClazz()])));
    }

    // ScheduleAbsencePage: set or clear `absences.<clazz>` for the caller's own class, before the
    // meeting starts, in the `{ reason, scheduledAt }` shape that meetingConverter reads back.
    function schedulesOwnAbsence() {
      let before = resource.data.get('absences', {});
      let after = request.resource.data.get('absences', {});
      return onlyChanges(['absences'])
        && request.time < resource.data.start
        && after.diff(before).affectedKeys().hasOnly([ownClazz()])
        && (!(ownClazz() in after) || isAbsence(after[ownClazz()]));
    }

    function isAbsence(absence) {
      return absence is map
        && absence.keys().hasAll(['reason', 'scheduledAt'])
        && absence.keys().hasOnly(['reason', 'scheduledAt'])
        && absence.reason is string
        && absence.scheduledAt is timestamp;
    }

    // AttendeePage: `speakRequests: arrayUnion(clazz)` / `arrayRemove(clazz)` for the caller's own class.
    function togglesOwnSpeakRequest() {
      let before = resource.data.get('speakRequests', []);
      let after = request.resource.data.get('speakRequests', []);
      return onlyChanges(['speakRequests'])
        && (after == before
          || after == before.removeAll([ownClazz()])
          || (!(ownClazz() in before) && after == before.concat([ownClazz()])));
    }

    // AttendeePage: `results.<choice>: arrayUnion(clazz)` together with `voters.<clazz>: choice`.
    // `voters` maps every class that has voted to its choice, so "one vote per class" is a single key
    // lookup rather than a scan over every choice. The caller's class must have punched in, the
    // votable must be the one the host has opened, and the class must not be in `voters` yet. The
    // only change allowed is adding the caller's own class to `voters` and to that one choice's
    // results. Repeating a vote that is already recorded changes nothing and stays allowed.
    function castsOwnVote(meetingId, proposalId, votableId) {
      return unchanged()
        || (onlyChanges(['results', 'voters'])
          && isOpenVoteOfPunchedInClass(meetingId, proposalId, votableId)
          && addsOneOwnVote(ownClazz()));
    }

    function isOpenVoteOfPunchedInClass(meetingId, proposalId, votableId) {
      let meeting = get(/databases/$(database)/documents/meetings/$(meetingId)).data;
      let proposal = get(/databases/$(database)/documents/meetings/$(meetingId)/proposals/$(proposalId)).data;
      return meeting.get('activeProposal', null) == proposalId
        && proposal.get('activeVotable', null) == votableId
        && ownClazz() in meeting.get('participants', []);
    }

    // A votable written before `voters` existed has no such field and is treated as having no voters.
    function addsOneOwnVote(clazz) {
      let votersBefore = resource.data.get('voters', {});
      let votersAfter = request.resource.data.get('voters', {});
      let resultsBefore = resource.data.get('results', {});
      let resultsAfter = request.resource.data.get('results', {});
      let choice = votersAfter.get(clazz, null);
      return !(clazz in votersBefore)
        && votersAfter.diff(votersBefore).affectedKeys().hasOnly([clazz])
        && choice in resource.data.choices
        && !(clazz in resultsBefore.get(choice, []))
        && resultsAfter.diff(resultsBefore).affectedKeys().hasOnly([choice])
        && resultsAfter[choice] == resultsBefore.get(choice, []).concat([clazz]);
    }
  }
}
